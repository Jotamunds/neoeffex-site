  "restricoes": [
    {
      "nome": "catalogs_business_hours_check",
      "tipo": "c",
      "tabela": "catalogs",
      "adiavel": false,
      "validada": true,
      "definicao": "CHECK (business_hours IS NULL OR char_length(TRIM(BOTH FROM business_hours)) >= 1 AND char_length(TRIM(BOTH FROM business_hours)) <= 200)"
    },
    {
      "nome": "catalogs_fulfillment_mode_check",
      "tipo": "c",
      "tabela": "catalogs",
      "adiavel": false,
      "validada": true,
      "definicao": "CHECK (fulfillment_mode IS NULL OR (fulfillment_mode = ANY (ARRAY['pickup'::text, 'delivery'::text, 'both'::text])))"
    },
    {
      "nome": "catalogs_logo_path_check",
      "tipo": "c",
      "tabela": "catalogs",
      "adiavel": false,
      "validada": true,
      "definicao": "CHECK (logo_path IS NULL OR logo_path ~ '^[0-9a-f-]{36}/[0-9a-f-]{36}/[0-9]{10,16}\\.(jpg|png|webp)$'::text)"
    },
    {
      "nome": "catalogs_name_check",
      "tipo": "c",
      "tabela": "catalogs",
      "adiavel": false,
      "validada": true,
      "definicao": "CHECK (char_length(TRIM(BOTH FROM name)) >= 2 AND char_length(TRIM(BOTH FROM name)) <= 100)"
    },
    {
      "nome": "catalogs_order_message_check",
      "tipo": "c",
      "tabela": "catalogs",
      "adiavel": false,
      "validada": true,
      "definicao": "CHECK (char_length(TRIM(BOTH FROM order_message)) >= 10 AND char_length(TRIM(BOTH FROM order_message)) <= 300)"
    },
    {
      "nome": "catalogs_orders_require_whatsapp_check",
      "tipo": "c",
      "tabela": "catalogs",
      "adiavel": false,
      "validada": true,
      "definicao": "CHECK (NOT orders_enabled OR whatsapp_number IS NOT NULL)"
    },
    {
      "nome": "catalogs_owner_id_fkey",
      "tipo": "f",
      "tabela": "catalogs",
      "adiavel": false,
      "validada": true,
      "definicao": "FOREIGN KEY (owner_id) REFERENCES auth.users(id) ON DELETE CASCADE"
    },
    {
      "nome": "catalogs_pkey",
      "tipo": "p",
      "tabela": "catalogs",
      "adiavel": false,
      "validada": true,
      "definicao": "PRIMARY KEY (id)"
    },
    {
      "nome": "catalogs_service_area_check",
      "tipo": "c",
      "tabela": "catalogs",
      "adiavel": false,
      "validada": true,
      "definicao": "CHECK (service_area IS NULL OR char_length(TRIM(BOTH FROM service_area)) >= 1 AND char_length(TRIM(BOTH FROM service_area)) <= 200)"
    },
    {
      "nome": "catalogs_short_description_check",
      "tipo": "c",
      "tabela": "catalogs",
      "adiavel": false,
      "validada": true,
      "definicao": "CHECK (short_description IS NULL OR char_length(TRIM(BOTH FROM short_description)) >= 1 AND char_length(TRIM(BOTH FROM short_description)) <= 200)"
    },
    {
      "nome": "catalogs_slug_check",
      "tipo": "c",
      "tabela": "catalogs",
      "adiavel": false,
      "validada": true,
      "definicao": "CHECK (slug ~ '^[a-z0-9]+(?:-[a-z0-9]+)*$'::text)"
    },
    {
      "nome": "catalogs_slug_key",
      "tipo": "u",
      "tabela": "catalogs",
      "adiavel": false,
      "validada": true,
      "definicao": "UNIQUE (slug)"
    },
    {
      "nome": "catalogs_whatsapp_number_check",
      "tipo": "c",
      "tabela": "catalogs",
      "adiavel": false,
      "validada": true,
      "definicao": "CHECK (whatsapp_number IS NULL OR whatsapp_number ~ '^[1-9][0-9]{9,14}$'::text)"
    },
    {
      "nome": "categories_catalog_id_fkey",
      "tipo": "f",
      "tabela": "categories",
      "adiavel": false,
      "validada": true,
      "definicao": "FOREIGN KEY (catalog_id) REFERENCES catalogs(id) ON DELETE CASCADE"
    },
    {
